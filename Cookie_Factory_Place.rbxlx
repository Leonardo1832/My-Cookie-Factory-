<Item class="ServerScriptService" referent="R00039"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Script" referent="R00038"><Properties>
<bool name="Disabled">false</bool>
<string name="Name">CookieFactoryServer</string>
<ProtectedString name="Source"><![CDATA[-- COOKIE FACTORY - gameplay server script
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local factory = Workspace:WaitForChild("CookieFactory")
local beltStart = factory:WaitForChild("BeltStart")
local sellPoint = factory:WaitForChild("SellPoint")
local upgradePad = factory:WaitForChild("UpgradePad")

local level = 1
local upgradeCost = 25
local busy = false

local function setupPlayer(player)
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    stats.Parent = player

    local cash = Instance.new("IntValue")
    cash.Name = "Cash"
    cash.Value = 0
    cash.Parent = stats

    local cookies = Instance.new("IntValue")
    cookies.Name = "Cookies"
    cookies.Value = 0
    cookies.Parent = stats
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in ipairs(Players:GetPlayers()) do
    if not player:FindFirstChild("leaderstats") then
        setupPlayer(player)
    end
end

local function makeBillboard()
    local gui = Instance.new("BillboardGui")
    gui.Name = "UpgradeInfo"
    gui.Size = UDim2.fromOffset(230, 75)
    gui.StudsOffset = Vector3.new(0, 3.5, 0)
    gui.AlwaysOnTop = true
    gui.Parent = upgradePad

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundColor3 = Color3.fromRGB(105, 57, 31)
    label.TextColor3 = Color3.fromRGB(255, 242, 195)
    label.Font = Enum.Font.FredokaOne
    label.TextScaled = true
    label.Parent = gui
    return label
end

local upgradeLabel = makeBillboard()
local function updateUpgradeText()
    upgradeLabel.Text = "COOKIE MACHINE\nLEVEL " .. level .. "  |  $" .. upgradeCost
end
updateUpgradeText()

local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Buy upgrade"
prompt.ObjectText = "Cookie Factory"
prompt.HoldDuration = 0.35
prompt.MaxActivationDistance = 12
prompt.Parent = upgradePad

prompt.Triggered:Connect(function(player)
    local stats = player:FindFirstChild("leaderstats")
    local cash = stats and stats:FindFirstChild("Cash")
    if cash and cash.Value >= upgradeCost then
        cash.Value -= upgradeCost
        level += 1
        upgradeCost = math.floor(upgradeCost * 1.6 + 10)
        updateUpgradeText()
    end
end)

local function createCookie()
    local cookie = Instance.new("Part")
    cookie.Name = "MovingCookie"
    cookie.Shape = Enum.PartType.Cylinder
    cookie.Size = Vector3.new(0.35, 1.5, 1.5)
    cookie.CFrame = beltStart.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(90))
    cookie.Anchored = true
    cookie.CanCollide = false
    cookie.Material = Enum.Material.SmoothPlastic
    cookie.Color = Color3.fromRGB(190, 119, 62)
    cookie.Parent = factory

    local target = sellPoint.Position + Vector3.new(0, 1.1, 0)
    local duration = math.max(1.25, 5 - (level - 1) * 0.3)
    local tween = TweenService:Create(cookie, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = target
    })
    tween:Play()
    tween.Completed:Wait()

    for _, player in ipairs(Players:GetPlayers()) do
        local stats = player:FindFirstChild("leaderstats")
        if stats then
            stats.Cash.Value += 5 * level
            stats.Cookies.Value += 1
        end
    end
    cookie:Destroy()
end

task.spawn(function()
    while factory.Parent do
        createCookie()
        task.wait(math.max(0.9, 4.5 - (level - 1) * 0.25))
    end
end)

print("🍪 Cookie Factory is running!")
]]></ProtectedString>
</Properties></Item>
</Item>
<Item class="StarterPlayer" referent="R00040"><Properties><string name="Name">StarterPlayer</string></Properties></Item>
